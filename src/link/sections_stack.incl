/* PORT: port-written for angband-pico, stage 050.
 *
 * Overrides pico-sdk 2.3.0's
 *   src/rp2_common/pico_standard_link/script_include/sections_stack.incl
 * through pico_add_linker_script_override_path() (see angband-pico/CMakeLists.txt).
 *
 * WHY. The SDK puts the core-0 stack at the top of SCRATCH_Y, which on the RP2350 is a
 * fixed 4 KB memory region -- so PICO_STACK_SIZE cannot be raised past 0x1000 whatever
 * value is asked for, and every link before this one reported "SCRATCH_Y 2 KB of 4 KB".
 * specifications.md 12 recorded that as a gap for this stage to close. The game cannot
 * live in it: ui-output.c's text_out_to_screen() alone puts a 1024-entry wchar_t buffer
 * (4 KB) plus av[256] + cv[256] (2 KB) in one frame, and init.c, savefile.c and z-file.c
 * carry 1024-byte path and line buffers in nested calls.
 *
 * WHAT. The core-0 stack moves to the end of the RAM region, after .bss and the (empty)
 * heap section, where PICO_STACK_SIZE is free to be as large as SRAM allows. The core-1
 * stack is left in SCRATCH_X, untouched and unused -- this port is single-core.
 *
 * The companion override section_end.incl recomputes __StackTop / __StackBottom /
 * __StackLimit, which the SDK's copy hard-codes to SCRATCH_Y.
 *
 * The only change from the SDK's file is the output region of .stack_dummy.
 */

SECTIONS
{
    /* .stack*_dummy section doesn't contains any symbols. It is only
     * used for linker to calculate size of stack sections, and assign
     * values to stack symbols later
     *
     * stack1 section may be empty/missing if platform_launch_core1 is not used */

    .stack1_dummy (NOLOAD):
    {
        *(.stack1*)
    } > SCRATCH_X

    /* PORT: SCRATCH_Y in the SDK's copy. See the note above. */
    .stack_dummy (NOLOAD):
    {
        KEEP(*(.stack*))
    } > RAM
}
